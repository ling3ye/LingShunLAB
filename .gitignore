# ──────────────────────────────────────────────────────────────
# Root .gitignore for the LingShunLAB showcase repo.
# Per-project .gitignore files (e.g. inside ESP-IDF examples) stay
# in place as a secondary safety net.
# ──────────────────────────────────────────────────────────────

# === macOS ===
.DS_Store
.AppleDouble
.LSOverride
.directory

# === ESP-IDF ===
# Build output (regenerated by `idf.py build`)
build/
# Components fetched by the ESP-IDF Component Manager
# (regenerated from main/idf_component.yml + dependencies.lock)
managed_components/
# Generated sdkconfig — keep the portable sdkconfig.defaults instead
sdkconfig
sdkconfig.old
sdkconfig.ci
# Stray build artifacts
*.bin
*.elf
*.map
flasher_args.json
compile_commands.json

# === PlatformIO (CH32V / Arduino-via-PIO examples) ===
# Build output (regenerated by `pio run`)
.pio/
# PlatformIO auto-generates these with absolute local paths (e.g. /Users/...)
# — never commit them. Portable .vscode/extensions.json stays tracked.
.vscode/c_cpp_properties.json
.vscode/launch.json
.vscode/.browse.c_cpp.db*
.vscode/ipch/

# === Python (MicroPython examples / tooling) ===
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# === Editor / IDE ===
.idea/
.cache/
*.swp
*.swo
*~
# NOTE: .vscode/ and .devcontainer/ are intentionally NOT ignored —
# their portable configs are committed to help others open/build.
